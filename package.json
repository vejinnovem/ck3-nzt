{
  "name": "ck3-nzt",
  "version": "0.2.0-alpha.1",
  "description": "Persistent strategic memory and AI advisory bridge for Crusader Kings III.",
  "type": "module",
  "license": "MIT",
  "author": "CK3-NZT contributors",
  "homepage": "https://github.com/vejinnovem/ck3-nzt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vejinnovem/ck3-nzt.git"
  },
  "bugs": {
    "url": "https://github.com/vejinnovem/ck3-nzt/issues"
  },
  "keywords": [
    "crusader-kings-iii",
    "ck3",
    "strategy",
    "ai",
    "mcp",
    "model-context-protocol",
    "paradox"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "ck3-advisor": "dist/index.js",
    "ck3-nzt-export": "dist/exporter.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "export": "node dist/exporter.js",
    "dev:export": "tsx src/exporter.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "adm-zip": "^0.5.16",
    "jomini": "^0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
