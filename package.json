{
  "name": "ck3-strategy-advisor",
  "version": "0.1.2",
  "description": "CK3-NZT: persistent strategic memory and AI advisory bridge for Crusader Kings III.",
  "type": "module",
  "license": "MIT",
  "author": "CK3-NZT contributors",
  "homepage": "https://github.com/vejinnovem/ck3-nzt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vejinnovem/ck3-nzt.git"
  },
  "bugs": {
    "url": "https://github.com/vejinnovem/ck3-nzt/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crusader-kings-iii",
    "ck3",
    "strategy",
    "ai",
    "paradox"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ck3-advisor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "export": "node dist/exporter.js",
    "dev:export": "tsx src/exporter.ts",
    "watch": "node dist/watcher.js",
    "dev:watch": "tsx src/watcher.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "jomini": "^0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
